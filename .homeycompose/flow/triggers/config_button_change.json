{
    "title": {
        "en": "A configuration button changed state",
		"nl": "Een configuratiebutton is van status veranderd"
    },
    "titleFormatted": {
                "en": "The [[left_right]] Button on [[display_button]] configuration [[config]] for [[page]] was [[state]]",
		"nl": "De [[left_right]] knop op [[display_button]] configuratie [[config]] voor [[page]] was [[state]]"
    },
    "tokens": [
        {
            "name": "state",
            "type": "boolean",
            "title": {
                "en": "State",
                "nl": "Status"
            },
            "example": "true"
        },
		{
			"name": "value",
			"type": "string",
			"title": {
				"en": "Value",
				"nl": "Waarde"
			},
			"example": "0.1"
		},
		{
			"name": "page",
			"type": "number",
			"title": {
				"en": "Page",
				"nl": "Pagina"
			},
			"example": "1"
        },
        {
            "name": "repeatCount",
            "type": "number",
            "title": {
                "en": "Number of repeats",
                "nl": "Aantal herhalingen"
            },
            "example": "0 = first event, 1 = first repeat, etc."
		}
    ],
    "deprecated": true,
    "args": [
        {
            "type": "dropdown",
            "name": "left_right",
            "title": {
                "en": "Left / Right",
                "nl": "Links / Rechts"
            },
            "placeholder": {
                "en": "Left / Right",
                "nl": "Links / Rechts"
            },
            "values": [
                {
                    "id": "left",
                    "title": {"en": "Left","nl": "Links"}
                },
                {
                    "id": "right",
                    "title": {"en": "Right","nl": "Rechts"}
                }
            ]
        },
        {
            "type": "dropdown",
            "name": "display_button",
            "title": {
                "en": "Display / Button",
                "nl": "Display / knop"
            },
            "placeholder": {
                "en": "Display / Button",
                "nl": "Display / knop"
            },
            "values": [
                {
                    "id": "display",
                    "title": {"en": "Display","nl": "Display"}
                },
                {
                    "id": "button",
                    "title": {"en": "Button","nl": "knop"}
                }
            ]
        },
        {
            "type": "number",
            "name": "config",
            "title": {
                "en": "Config Number",
                "nl": "Configuratie nummer"
            },
            "placeholder": {
                "en": "Config number (1-40)",
                "nl": "Configuratie nummer (1-40)"
            },
            "min": 1,
            "max": 40,
            "step": 1
        },
        {
            "type": "autocomplete",
            "name": "page",
            "required": false,
            "title": {
                "en": "Page",
                "nl": "Pagina"
            },
            "hint": {
                "en": "Choose a page, or All for any page.",
                "nl": "Kies een pagina, of Alle voor elke pagina."
            },
            "placeholder": {
                "en": "All",
                "nl": "Alle"
            }
        },
        {
            "type": "dropdown",
            "name": "state",
            "title": {
                "en": "State",
                "nl": "Status"
            },
            "placeholder": {
                "en": "Clicked / Released / Short Pressed / Long Pressed",
                "nl": "Ingedrukt / Losgelaten / Kort ingedrukt / Lang ingedrukt"
            },
            "values": [
                {
                    "id": "clicked",
                    "title": {"en": "Clicked","nl": "ingedrukt"}
                },
                {
                    "id": "released",
                    "title": {"en": "Released","nl": "Losgelaten"}
                },
                {
                    "id": "long",
                    "title": {"en": "Long Pressed","nl": "Lang ingedrukt"}
                }
            ]
        },
        {
            "name": "device",
            "type": "device",
            "filter": "driver_id=panel_hardware"
        }
    ]
}
