{
    "title": {
        "en": "A configuration button event occurred",
        "nl": "Een configuratie knop gebeurtenis heeft plaatsgevonden"
    },
    "titleFormatted": {
        "en": "The [[left_right]] Button on [[display_button]] configuration [[config]] for [[page]] was [[state]]",
        "nl": "De [[left_right]] knop op [[display_button]] configuratie [[config]] voor [[page]] was [[state]]"
    },
	"highlight": true,
    "tokens": [
		{
			"name": "state",
			"type": "boolean",
			"title": {
				"en": "State",
				"nl": "Status"
			},
			"example": "true"
		},
		{
			"name": "value",
			"type": "string",
			"title": {
				"en": "Value",
				"nl": "Waarde"
			},
			"example": "0.1"
		},
		{
			"name": "page",
			"type": "number",
			"title": {
				"en": "Page",
				"nl": "Pagina"
			},
			"example": "1"
        },
        {
            "name": "repeatCount",
            "type": "number",
            "title": {
                "en": "Number of repeats",
                "nl": "Aantal herhalingen"
            },
            "example": "0 = first event, 1 = first repeat, etc."
		}
    ],
    "args": [
        {
            "type": "dropdown",
            "name": "left_right",
            "title": {
                "en": "Left / Right",
                "nl": "Links / Rechts"
            },
            "placeholder": {
                "en": "Left / Right",
                "nl": "Links / Rechts"
            },
            "values": [
                {
                    "id": "left",
                    "title": {"en": "Left","nl": "Links"}
                },
                {
                    "id": "right",
                    "title": {"en": "Right","nl": "Rechts"}
                }
            ]
        },
        {
            "type": "dropdown",
            "name": "display_button",
            "title": {
                "en": "Display / Button",
                "nl": "Display / Knop"
            },
            "placeholder": {
                "en": "Display / Button",
                "nl": "Display / Knop"
            },
            "values": [
                {
                    "id": "display",
                    "title": {"en": "Display","nl": "Display"}
                },
                {
                    "id": "button",
                    "title": {"en": "Button","nl": "Knop"}
                }
            ]
        },
        {
            "type": "autocomplete",
            "name": "config",
            "title": {
                "en": "Configuration",
                "nl": "Configuratie"
            },
            "hint": {
                "en": "Find this Configuration on a button connector",
                "nl": "Vind deze configuratie op een knop connector"
            },
            "placeholder": {
                "en": "Choose a configuration",
                "nl": "Kies een configuratie"
            }
        },
        {
            "type": "autocomplete",
            "name": "page",
            "required": false,
            "title": {
                "en": "Page",
                "nl": "Pagina"
            },
            "hint": {
                "en": "Choose a page, or All for any page.",
                "nl": "Kies een pagina, of Alle voor elke pagina."
            },
            "placeholder": {
                "en": "All",
                "nl": "Alle"
            }
        },
        {
            "type": "dropdown",
            "name": "state",
            "title": {
                "en": "State",
                "nl": "Status"
            },
            "placeholder": {
                "en": "Clicked / Released / Long Pressed",
                "nl": "Ingedrukt / Losgelaten / Lang ingedrukt"
            },
            "values": [
                {
                    "id": "clicked",
                    "title": {"en": "Clicked","nl": "Ingedrukt"}
                },
                {
                    "id": "released",
                    "title": {"en": "Released","nl": "Losgelaten"}
                },
                {
                    "id": "long",
                    "title": {"en": "Long Pressed","nl": "Lang ingedrukt"}
                },
                {
                    "id": "double",
                    "title": {"en": "Double Clicked","nl": "Dubbel ingedrukt"}
                }
            ]
        },
        {
            "name": "device",
            "type": "device",
            "filter": "driver_id=panel_hardware"
        }
    ]
}
